{
  "name": "project-os-command-center",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Project OS Command Center — local-first, privacy-first, multi-engine supervised agent-loop cockpit",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node server/index.mjs",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "electron": "electron .",
    "app:build": "npm run build && electron-builder --mac --dir",
    "app:dist": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "express": "^4.21.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.1.2",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.0"
  },
  "build": {
    "appId": "com.zaid.projectos.commandcenter",
    "productName": "Project OS Command Center",
    "asar": false,
    "directories": { "output": "release" },
    "files": ["dist/**/*", "server/**/*", "electron/**/*", "package.json", ".env"],
    "extraMetadata": { "main": "electron/main.cjs" },
    "mac": { "target": "dir", "category": "public.app-category.developer-tools", "icon": "build/AppIcon.icns" }
  }
}
